# Martin and 3D Tiles hosts used by the Vite development proxy.
VITE_MARTIN_URL=https://tiles.leokratis.com
VITE_TILES_URL=https://tiles.leokratis.com

# Required to enable setRepresentation('photorealistic-3d'). Use a direct
# tileset URL when deploying the dataset elsewhere. During local development,
# the Vite server serves this path from VITE_3D_TILES_LOCAL_DIR when present.
VITE_3D_TILES_URL=/tiles/kav-10pct/tileset.json
VITE_3D_TILES_LOCAL_DIR=/mnt/Main/kav-10pct/tiles-work/output
VITE_3D_TILES_ORIGIN_LON=24.3787057
VITE_3D_TILES_ORIGIN_LAT=40.9294296
VITE_3D_TILES_ORIGIN_HEIGHT=0
# Screen-space error target for hierarchical 3D Tiles exports.
VITE_3D_TILES_ERROR_TARGET=16
